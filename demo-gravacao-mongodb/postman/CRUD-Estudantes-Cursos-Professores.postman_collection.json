{
  "info": {
    "name": "CRUD - Estudantes, Cursos e Professores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "estudanteId",
      "value": "1"
    },
    {
      "key": "cursoId",
      "value": "curso1"
    },
    {
      "key": "professorId",
      "value": "prof1"
    }
  ],
  "item": [
    {
      "name": "Estudante",
      "item": [
        {
          "name": "Cadastrar Estudante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estudantes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estudantes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"1\",\n  \"nome\": \"João da Silva\",\n  \"idade\": 30,\n  \"email\": \"joao.silva@email.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"estudanteId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar todos Estudante",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estudantes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estudantes"
              ]
            }
          }
        },
        {
          "name": "Buscar por ID Estudante",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estudantes/{{estudanteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estudantes",
                "{{estudanteId}}"
              ]
            }
          }
        },
        {
          "name": "Atualizar Estudante",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estudantes/{{estudanteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estudantes",
                "{{estudanteId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nome Atualizado\",\n  \"idade\": 30,\n  \"email\": \"joao.silva@email.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Excluir Estudante",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
